COMPETITION_MODE=1
LLM_PROVIDER=hyperclova
CLOVA_STUDIO_API_KEY=nv-7f8785ed9ed44743aa3a2245a67045d0iV7w
CLOVA_MODEL=HCX-005
CLOVA_BASE_URL=https://clovastudio.stream.ntruss.com


LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2

SEMANTIC_REVIEW_ENABLED=true
LLM_FAIL_FAST=false

STORAGE_BACKEND=json
CACHE_DIR=data/cache

SCHEMA_VERSION=0.2

LOG_LEVEL=INFO

# PDF -> Standard JSON -> PostgreSQL
DB_AUTO_SAVE=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pension_agent
STANDARD_JSON_DIR=data/standard_json
STANDARD_SCHEMA_VERSION=0.1
PRODUCT_DB_BACKEND=auto
# National Law Information Center Open API (secret value stays only in local .env)
LAW_API_OC=pensionagent2026
LAW_API_TIMEOUT=20
LAW_API_SEARCH_TARGET=law
LAW_API_SERVICE_TARGET=law

# Legal serving layer: chat reads this DB; Open API is used by the sync job.
LEGAL_DB_PATH=data/legal/pension_legal.db
LAW_QUERY_FALLBACK_API=0


# Per-role HyperCLOVA X models
CLOVA_ANSWER_MODEL=HCX-005
CLOVA_SUPERVISOR_MODEL=HCX-007
CLOVA_NORMALIZER_MODEL=HCX-DASH-002
CLOVA_EXTRACTION_MODEL=HCX-005
